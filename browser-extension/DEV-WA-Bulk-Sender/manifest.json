{
  "manifest_version": 3,
  "name": "DEV WA Bulk Sender",
  "version": "2.2.0",
  "description": "WhatsApp Web se personalised message + images/PDF bhejne ke liye (DEV GROUP). DEV OMS se bhi seedha queue hota hai. Quick Docs: firm-wise PDFs 1 click me.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "DEV WA Bulk Sender",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "quickdoc/settings.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "wppconnect-wa.js",
        "bridge-main.js",
        "quickdoc/qd-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "common.js",
        "content.js",
        "quickdoc/selectors.js",
        "quickdoc/qd-common.js",
        "quickdoc/qd-attach.js",
        "quickdoc/qd-panel.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "https://dev-two-gilt.vercel.app/*"
      ],
      "js": [
        "oms-connector.js"
      ],
      "run_at": "document_start"
    }
  ],
  "minimum_chrome_version": "111"
}
